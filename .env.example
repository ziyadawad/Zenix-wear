# ---- Required in production -----------------------------------------------
# Public site URL with https:// and no trailing slash (used for SEO, sitemap, payment callbacks)
NEXT_PUBLIC_SITE_URL=

# Random 32+ character secret that signs customer sessions and order links. Generate: npm run admin:password
SESSION_SECRET=

# Owner login for /dashboard and /admin (one login for both). Set these in Vercel, never in code or Git.
# DASHBOARD_PASSWORD: a long password only you know (16+ characters).
# DASHBOARD_SESSION_SECRET: random 32+ characters that sign the login cookie. Generate: npm run admin:password
DASHBOARD_PASSWORD=
DASHBOARD_SESSION_SECRET=

# Postgres connection string (added automatically when Neon is connected in Vercel).
# Leave empty locally to use the built-in embedded database in .data/
DATABASE_URL=

# Image uploads. Added automatically when a PRIVATE Vercel Blob store is connected in Vercel.
# Leave empty locally to save uploads in .data/uploads
BLOB_READ_WRITE_TOKEN=

# ---- New order emails (resend.com) -----------------------------------------
RESEND_API_KEY=
# Leave EMAIL_FROM empty to use Resend's test sender until you verify a domain.
# ORDER_NOTIFY_EMAIL is the inbox that receives new-order alerts.
EMAIL_FROM=
ORDER_NOTIFY_EMAIL=

# ---- Paymob card payments (optional; the option appears once these are set) --
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_INTEGRATION_ID=
PAYMOB_HMAC_SECRET=
