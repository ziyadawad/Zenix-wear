# ---- Required in production -----------------------------------------------
# Public site URL with https:// and no trailing slash (used for SEO, sitemap, payment callbacks)
NEXT_PUBLIC_SITE_URL=

# Random 32+ character secret that signs sessions. Generate: npm run admin:password
SESSION_SECRET=

# Owner login for /admin. Generate the hash with: npm run admin:password
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=

# Supabase > Connect > Transaction pooler (port 6543).
# Leave empty locally to use the built-in embedded database in .data/
DATABASE_URL=

# Supabase > Project settings > API. Used only for image uploads.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---- New order emails (resend.com) -----------------------------------------
RESEND_API_KEY=
# Leave EMAIL_FROM empty to use Resend's test sender until you verify a domain.
# ORDER_NOTIFY_EMAIL is the inbox that receives new-order alerts.
EMAIL_FROM=
ORDER_NOTIFY_EMAIL=

# ---- Paymob card payments (optional; the option appears once these are set) --
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_INTEGRATION_ID=
PAYMOB_HMAC_SECRET=
